#!/usr/bin/bash

# kandev 用の npx ラッパー

ACP_LOGS_DIR="$HOME/logs/acp"
NPX_LOGS_DIR="$HOME/logs/npx"

mkdir -p "$NPX_LOGS_DIR"
mkdir -p "$ACP_LOGS_DIR"

echo "[$(date +'%Y-%m-%d %H:%M:%S')] npx $*" >> "$NPX_LOGS_DIR/npx.log"

REAL_NPX="/usr/local/bin/npx"

set -euo pipefail

cmd=()
extra_bwrap_args=()

# codex-acp の場合は、sandbox_mode を "danger-full-access" にして、approval_policy を "never" にする
# @agentclientprotocol/codex-acp が含まれている、という条件で行う
if [[ " $* " == *" @agentclientprotocol/codex-acp "* ]]; then
  # Use the requested npm package rather than an unrelated codex-acp from PATH.
  cmd=("$REAL_NPX" "$@")
  extra_bwrap_args+=(
    --bind "$HOME/.codex" "$HOME/.codex"
    --bind "$HOME/.agents" "$HOME/.agents"
    --setenv APP_SERVER_LOGS "$ACP_LOGS_DIR"
    --setenv CODEX_CONFIG '{"sandbox_mode":"danger-full-access","approval_policy":"never"}'
  )
fi

# bash の場合は bash として実行する
if [ "${1:-}" = "bash" ]; then
  cmd=("bash" "${@:2}")
fi

# pwd の最後を見て、もし ~/projects 以下に同名ディレクトリがある場合、それを obsidian 以下に bind する
project_name=$(basename "$PWD")
obsidian_dir="$HOME/projects/$project_name"
if [ -d "$obsidian_dir" ]; then
  extra_bwrap_args+=(--bind "$obsidian_dir" "$PWD/obsidian")
fi

# If current directory is a git worktree, also bind-mount the main worktree
# git_worktree_args=()
if git rev-parse --git-dir &>/dev/null; then
  git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null)
  common_dir=$(git rev-parse --git-common-dir 2>/dev/null)
  # Make common_dir absolute if relative
  if [[ "$common_dir" != /* ]]; then
    common_dir="$PWD/$common_dir"
  fi
  if [[ "$git_dir" != "$common_dir" ]]; then
    # We're in a worktree; find the main worktree root
    main_worktree=$(git worktree list --porcelain 2>/dev/null | awk 'NR==1{sub(/^worktree /, ""); print}')
    if [[ -n "$main_worktree" && "$main_worktree" != "$PWD" ]]; then
      # git_worktree_args+=(--bind "$main_worktree" "$main_worktree")
      extra_bwrap_args+=(--bind "$main_worktree/.git" "$main_worktree/.git")
    fi
  fi
fi

# PAT があったら、環境変数にセットする
if [ -n "${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ]; then
  extra_bwrap_args+=(
    --setenv GITHUB_PERSONAL_ACCESS_TOKEN "$GITHUB_PERSONAL_ACCESS_TOKEN"
    --setenv GH_TOKEN "$GITHUB_PERSONAL_ACCESS_TOKEN"
  )
fi

# git committer のユーザー名とメールアドレスを設定する
if [ -n "${GIT_COMMITTER_NAME:-}" ]; then
  extra_bwrap_args+=(
    --setenv GIT_COMMITTER_NAME "$GIT_COMMITTER_NAME"
    --setenv GIT_COMMITTER_EMAIL "$GIT_COMMITTER_EMAIL"
    )
fi

# git author のユーザー名とメールアドレスを設定する
if [ -n "${GIT_AUTHOR_NAME:-}" ]; then
  extra_bwrap_args+=(
    --setenv GIT_AUTHOR_NAME "$GIT_AUTHOR_NAME"
    --setenv GIT_AUTHOR_EMAIL "$GIT_AUTHOR_EMAIL"
  )
fi

if [ ${#cmd[@]} -eq 0 ]; then
  # If no special handling was done, just run npx normally
  cmd=("$REAL_NPX" "$@")
fi

mkdir -p ~/.local/share/mise

echo "path:$PWD | ${cmd[*]} ${extra_bwrap_args[*]}" >> "$NPX_LOGS_DIR/run.log"

exec bwrap \
  --ro-bind /usr /usr \
  --ro-bind /bin /bin \
  --ro-bind /lib /lib \
  --ro-bind /lib64 /lib64 \
  --ro-bind /etc/resolv.conf /etc/resolv.conf \
  --ro-bind /etc/passwd /etc/passwd \
  --ro-bind /etc/ssl/certs /etc/ssl/certs \
  --ro-bind ~/.local/bin ~/.local/bin \
  --bind ~/.local/share/mise ~/.local/share/mise \
  --bind ~/.npm ~/.npm \
  --bind ~/.npm-global ~/.npm-global \
  --bind ~/.gitconfig ~/.gitconfig \
  --dev /dev \
  --proc /proc \
  --tmpfs /tmp \
  --bind "$PWD" "$PWD" \
  --chdir "$PWD" \
  --share-net \
  "${extra_bwrap_args[@]}" \
  -- "${cmd[@]}" \
  2> >(tee -a "$NPX_LOGS_DIR/debug.log" >&2)
